  m_Script: {fileID: 11500000, guid: 8056aac9885cd9845980e4bf8874f09a, type: 3}
  m_Name: Greeting_PC2
  m_EditorClassIdentifier: Assembly-CSharp::HelperDialogue
  lines:
  - text: "\u041E, \u0438 \u0442\u0443\u0442 \u044F! \u042D\u0442\u043E\u0442 \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440 \u0442\u043E\u0436\u0435 \u043C\u043E\u0439... \u0442\u043E \u0435\u0441\u0442\u044C, \u043D\u0430\u0448."
    textEn: Oh, I'm here too! This computer is mine as well... I mean, ours.
    emotion: 2
    shape: 0
    autoNext: 0
  - text: "\u0414\u0430\u0432\u0430\u0439 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C, \u0447\u0442\u043E \u0442\u0443\u0442 \u0437\u0430\u0448\u0438\u0444\u0440\u043E\u0432\u0430\u043D\u043E."
    textEn: Let's see what's encrypted here.
    emotion: 3
    shape: 1
    autoNext: 0
