  m_Script: {fileID: 11500000, guid: 8056aac9885cd9845980e4bf8874f09a, type: 3}
  m_Name: Greeting_PC3
  m_EditorClassIdentifier: Assembly-CSharp::HelperDialogue
  lines:
  - text: "\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439! \u042F \u0442\u0430\u043A \u0436\u0434\u0430\u043B... \u0442\u043E \u0435\u0441\u0442\u044C, \u0442\u044B \u043C\u043E\u043B\u043E\u0434\u0435\u0446, \u0447\u0442\u043E \u0434\u043E\u0448\u0451\u043B."
    textEn: The last one! I've been waiting... I mean, well done getting here.
    emotion: 2
    shape: 1
    autoNext: 0
  - text: "\u041E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u0441\u043E\u0432\u0441\u0435\u043C \u0447\u0443\u0442\u044C-\u0447\u0443\u0442\u044C."
    textEn: Just a little bit left.
    emotion: 3
    shape: 0
    autoNext: 0
