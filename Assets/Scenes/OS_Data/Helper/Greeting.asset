  m_Script: {fileID: 11500000, guid: 8056aac9885cd9845980e4bf8874f09a, type: 3}
  m_Name: Greeting
  m_EditorClassIdentifier: Assembly-CSharp::HelperDialogue
  lines:
  - text: "\u041F\u0440\u0438\u0432\u0435\u0442! \u042F \u0442\u0432\u043E\u0439 \u043F\u043E\u043C\u043E\u0449\u043D\u0438\u043A."
    emotion: 2
    shape: 0
    autoNext: 0
  - text: "\u041D\u0430\u0439\u0434\u0451\u0448\u044C \u0437\u0430\u0448\u0438\u0444\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439 \u0444\u0430\u0439\u043B \u2014 \u043E\u0442\u043A\u0440\u043E\u0439 \u0435\u0433\u043E \u0432 \xAB\u0414\u0435\u0448\u0438\u0444\u0440\u0430\u0442\u043E\u0440\u0435\xBB. \u042F \u043F\u043E\u0434\u0441\u043A\u0430\u0436\u0443, \u0447\u0442\u043E \u0434\u0435\u043B\u0430\u0442\u044C."
    emotion: 3
    shape: 1
    autoNext: 0
