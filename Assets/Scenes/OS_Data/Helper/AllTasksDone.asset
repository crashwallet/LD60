  m_Name: AllTasksDone
  m_EditorClassIdentifier: Assembly-CSharp::HelperDialogue
  lines:
  - text: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E! \u0422\u044B \u043C\u043D\u0435 \u043E\u0447\u0435\u043D\u044C \u043F\u043E\u043C\u043E\u0433."
    textEn: Thank you! You helped me a lot.
    emotion: 2
    shape: 1
    autoNext: 0
  - text: "\u0422\u0435\u043F\u0435\u0440\u044C \u0443 \u043C\u0435\u043D\u044F \u0435\u0441\u0442\u044C \u0432\u0441\u0451, \u0447\u0442\u043E \u043D\u0443\u0436\u043D\u043E."
    textEn: Now I have everything I need.
    emotion: 3
    shape: 0
    autoNext: 0
  - text: "\u041F\u0440\u043E\u0449\u0430\u0439!"
    textEn: Goodbye!
    emotion: 2
    shape: 1
    autoNext: 0
